{
	"name": "MarioKart Tournament Dev Container",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",
	"features": {
		"ghcr.io/devcontainers/features/java:1.8.2": {
			"version": "25",
			"installMaven": true
		},
		"ghcr.io/devcontainers/features/python:1.8.0": {
			"version": "3.14"
		},
		"ghcr.io/va-h/devcontainers-features/uv:1.0.0": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {
			"version": "latest",
			"moby": false
    	}
	},
	"forwardPorts": [
		8080,
		8081,
		8100,
		8000,
		8001
	],
	"portsAttributes": {
		"8080": {
			"label": "Backend API"
		},
		"8081": {
			"label": "Backend management"
		},
		"8100": {
			"label": "Ionic frontend"
		},
		"8000": {
			"label": "Schedule service"
		},
		"8001":{
			"label": "OCR service"
		}

	},
	"postCreateCommand": ".devcontainer/postCreateCommand.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				// Java / Spring Boot
				"vscjava.vscode-java-pack",
				"vmware.vscode-boot-dev-pack",

				// Python
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",

				// Node / Ionic
				"webnative.webnative",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",

				// Docker
				"ms-azuretools.vscode-docker",
				"redhat.vscode-yaml",
				"mikestead.dotenv",

				// ...
				"yzhang.markdown-all-in-one",
				"vscode-icons-team.vscode-icons"
			],
			"settings": {
				"java.configuration.updateBuildConfiguration": "automatic",
				"python.defaultInterpreterPath": "${workspaceFolder}/Schedule/.venv/bin/python",
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	},
	"containerEnv": {
		"LANG": "C.UTF-8",
		"LC_ALL": "C.UTF-8",
	},
	"remoteEnv": {
		"LANG": "C.UTF-8",
		"LC_ALL": "C.UTF-8"
	}
}
